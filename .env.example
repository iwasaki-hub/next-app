# Public Supabase credentials for this app's own project (not LittleDiary).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Canonical URL used for email confirmation links.
# Use the production URL in production, http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never commit service_role, secret keys, or actual .env.local files.
